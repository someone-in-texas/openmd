title = sys.argv[3]
generated_at = sys.argv[4]

markdown_text = markdown_path.read_text(encoding="utf-8", errors="replace")


def git_preview():
    # Git is optional. All commands are read-only, including in linked worktrees.
    git_dir = markdown_path.parent

    def git(*args):
        try:
            return subprocess.run(
                ["git", "-C", str(git_dir), *args],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                env={**os.environ, "GIT_OPTIONAL_LOCKS": "0", "GIT_LITERAL_PATHSPECS": "1"},
                check=False,
            )
        except FileNotFoundError:
            return None

    root = git("rev-parse", "--show-toplevel")
    if root is None or root.returncode:
        return None
    git_dir = pathlib.Path(os.fsdecode(root.stdout).rstrip("\n"))
    try:
        relative = (markdown_path.parent.resolve() / markdown_path.name).relative_to(git_dir.resolve()).as_posix()
    except ValueError:
        return None
    tracked = git("ls-files", "--error-unmatch", "--", relative)
    head_file = git("cat-file", "-t", "HEAD:" + relative)
    if tracked.returncode and (head_file.returncode or head_file.stdout.strip() != b"blob"):
        return None

    def status(*paths):
        result = git("status", "--porcelain=v1", "-z", "--untracked-files=normal", "--no-renames", *paths)
        if result.returncode:
            return "Status unavailable"
        codes = [entry[:2] for entry in result.stdout.split(b"\0") if entry]
        labels = []
        if any(code[:1] not in (b" ", b"?") for code in codes):
            labels.append("staged changes")
        if any(code[1:2] not in (b" ", b"?") for code in codes):
            labels.append("unstaged changes")
        if b"??" in codes:
            labels.append("untracked files")
        return ", ".join(labels) if labels else "clean"

    head = git("rev-parse", "--verify", "HEAD")
    commit = head.stdout.decode().strip() if not head.returncode else None
    branch = git("symbolic-ref", "--quiet", "--short", "HEAD")
    branch_name = os.fsdecode(branch.stdout).strip() if not branch.returncode else "Detached HEAD"
    if not commit:
        branch_name += " (no commits yet)"
    elif branch.returncode:
        branch_name += " at " + commit[:12]

    versions = [{"label": "Working copy", "markdown": markdown_text, "detail": "Current file at generation time"}]
    cache = {}

    def add_version(label, oid):
        if oid not in cache:
            kind = git("cat-file", "-t", oid + ":" + relative)
            blob = git("show", oid + ":" + relative) if kind.stdout.strip() == b"blob" else None
            cache[oid] = blob.stdout.decode("utf-8", errors="replace") if blob and not blob.returncode else None
        text = cache[oid]
        versions.append({
            "label": label,
            "markdown": text,
            "detail": "Commit " + oid[:12] if text is not None else "File absent or unreadable at this revision",
        })

    if commit:
        add_version("Last committed version (HEAD)", commit)
    branches = git("for-each-ref", "--format=%(refname)\t%(objectname)", "refs/heads/")
    for line in os.fsdecode(branches.stdout).splitlines():
        ref, oid = line.split("\t", 1)
        add_version("Branch: " + ref[len("refs/heads/"):], oid)
    return {
        "branch": branch_name,
        "repositoryStatus": status(),
        "fileStatus": status("--", relative),
        "versions": versions,
    }


git_data = git_preview()


def safe_json(value):
    return json.dumps(value).replace('</', '<\\/')

data = {
    "base_html": html.escape(markdown_path.parent.as_uri() + "/", quote=True),
    "git_json": safe_json(git_data),
    "title_html": html.escape(title),
    "title_json": safe_json(title),
    "markdown_json": safe_json(markdown_text),
    "header_basename": html.escape(markdown_path.name),
    "header_abspath": html.escape(str(markdown_path)),
    "file_json": safe_json(str(markdown_path)),
    "basename_json": safe_json(markdown_path.name),
    "generated_json": safe_json(generated_at),
    "generated_at": generated_at,
}

