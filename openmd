#!/usr/bin/env bash
# openmd: Render Markdown files into polished HTML previews.
set -euo pipefail

VERSION="0.5"

usage() {
  cat <<'EOF'
Usage: openmd [options] <markdown-file>

Options:
  --title TEXT   Set a custom HTML <title>
  --no-open      Generate the preview without launching a browser
  --version     Print the installed version
  -h, --help     Show this help and exit

Environment:
  OPENMD_NO_OPEN=1        Skip launching the browser (useful for tests/CI)
  OPENMD_OUTPUT_DIR=/path Directory for generated previews (defaults to TMPDIR)

Preview features:
  • GitHub-flavored Markdown rendering via Marked.js
  • Syntax highlighting via highlight.js
  • Dark/light themes with system sync and manual toggles
  • Quick actions for saving PDFs and copying Markdown or paths
  • Sticky metadata header and safe anchor navigation
  • Local links and images resolved relative to the Markdown file
  • Git working-copy status, HEAD, and local-branch version selection
EOF
}

error() {
  printf 'openmd: %s\n' "$1" >&2
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    error "required command '$1' not found"
    exit 1
  fi
}

parse_args() {
  local positional=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title)
        if [[ $# -lt 2 ]]; then
          error "--title requires an argument"
          exit 1
        fi
        PAGE_TITLE="$2"
        shift 2
        ;;
      --version)
        printf 'openmd %s\n' "$VERSION"
        exit 0
        ;;
      --no-open)
        NO_OPEN=1
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      --)
        shift
        positional+=("$@")
        break
        ;;
      -*)
        error "unknown option: $1"
        usage >&2
        exit 1
        ;;
      *)
        positional+=("$1")
        shift
        ;;
    esac
  done

  if [[ "${#positional[@]}" -ne 1 ]]; then
    error "exactly one Markdown file is required"
    usage >&2
    exit 1
  fi

  MARKDOWN_FILE="${positional[0]}"
}

abspath() {
  python3 - "$1" <<'PY'
import os
import sys
print(os.path.abspath(sys.argv[1]))
PY
}

create_temp_html() {
  local base_dir="${OPENMD_OUTPUT_DIR:-${TMPDIR:-/tmp}}"
  if [[ ! -d "$base_dir" ]]; then
    error "output directory '$base_dir' does not exist"
    exit 1
  fi
  local tmpfile
  tmpfile=$(mktemp "$base_dir/openmd.XXXXXX") || {
    error "failed to create temporary file"
    exit 1
  }
  GENERATED_HTML="${tmpfile}.html"
  mv "$tmpfile" "$GENERATED_HTML"
}

launch_browser() {
  local target="$1"
  if command -v open >/dev/null 2>&1; then
    open "$target" >/dev/null 2>&1 &
    return 0
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$target" >/dev/null 2>&1 &
    return 0
  elif command -v start >/dev/null 2>&1; then
    start "" "$target" >/dev/null 2>&1 &
    return 0
  fi
  error "could not locate a browser launcher (expected one of: open, xdg-open, start)"
  return 1
}

PAGE_TITLE=""
NO_OPEN=0
MARKDOWN_FILE=""

parse_args "$@"

require_command python3

if [[ ! -f "$MARKDOWN_FILE" ]]; then
  error "file not found: $MARKDOWN_FILE"
  exit 1
fi

ABS_PATH=$(abspath "$MARKDOWN_FILE")
BASENAME=$(basename "$ABS_PATH")
TITLE=${PAGE_TITLE:-"${BASENAME} — Markdown Preview"}
GENERATED_AT=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

create_temp_html

python3 - "$GENERATED_HTML" "$ABS_PATH" "$TITLE" "$GENERATED_AT" <<'PY'
import html
import json
import os
import pathlib
import re
import subprocess
import sys
from textwrap import dedent

