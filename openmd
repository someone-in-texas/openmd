      <script src="https://cdn.jsdelivr.net/npm/marked@12.0.2/marked.min.js"></script>
      <script src="https://cdn.jsdelivr.net/npm/@highlightjs/cdn-assets@11.9.0/highlight.min.js"></script>
      <script>
        const SOURCE = {
          markdown: __MARKDOWN_JSON__,
          git: __GIT_JSON__,
          title: __TITLE_JSON__,
          file: __FILE_JSON__,
          basename: __BASENAME_JSON__,
          generated: __GENERATED_JSON__
        };
      </script>
      <script>
        (() => {
          let sourceMarkdown = SOURCE.markdown;
          const contentEl = document.getElementById('content');
          const toastEl = document.querySelector('.toast');
          let toastTimer = null;

          const THEME_STORAGE_KEY = 'openmd-theme';
          const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');

          const createSlugger = () => {
            const seen = new Map();
            return {
              slug(value) {
                const base = String(value)
                  .trim()
                  .toLowerCase()
                  .replace(/<[^>]+>/g, '')
                  .replace(/[^a-z0-9\\s-]/g, '')
                  .replace(/\\s+/g, '-')
                  .replace(/-+/g, '-')
                  .replace(/^-|-$/g, '');
                const count = seen.get(base) || 0;
                seen.set(base, count + 1);
                return count ? `${base}-${count}` : base;
              },
              reset() {
                seen.clear();
              }
            };
          };

          const ensureMarked = () => {
            if (window.marked && typeof window.marked.parse === 'function') {
              return window.marked;
            }
            console.warn('openmd: marked CDN unavailable, using fallback renderer');
            return null;
          };

          const markedRef = ensureMarked();
          const slugger = markedRef && typeof markedRef.Slugger === 'function'
            ? new markedRef.Slugger()
            : createSlugger();

          if (markedRef) {
            const renderer = new markedRef.Renderer();
            renderer.heading = (text, level, raw) => {
              const slug = slugger.slug(raw);
              return `<h${level} id="${slug}">${text}</h${level}>`;
            };

            markedRef.use({ renderer });
            markedRef.setOptions({
              gfm: true,
              breaks: false,
              mangle: false,
              headerIds: true
            });
          }

          const escapeHtml = (value) => value
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');

          const fallbackRender = (markdown) => `<pre class="fallback-markdown">${escapeHtml(markdown)}</pre>`;

          const locateHeading = (rawId) => {
            if (!rawId) return null;
            const candidates = new Set([rawId]);
            const collapsedHyphen = rawId.replace(/-+/g, '-');
            candidates.add(collapsedHyphen);
            const lower = rawId.toLowerCase();
            candidates.add(lower);
            candidates.add(lower.replace(/-+/g, '-'));
            for (const candidate of candidates) {
              if (!candidate) continue;
              const el = document.getElementById(candidate);
              if (el) {
                return el;
              }
            }
            return null;
          };

          const scrollToHash = (hash, behavior = 'smooth') => {
            if (!hash || hash === '#') return false;
            let id;
            try {
              id = decodeURIComponent(hash.replace(/^#/, ''));
            } catch (err) {
              return false;
            }
            if (!id) return false;
            const target = locateHeading(id);
            if (!target) return false;
            target.style.scrollMarginTop = `${document.querySelector('header').getBoundingClientRect().height + 16}px`;
            target.scrollIntoView({ behavior, block: 'start' });
            return true;
          };

          const renderMarkdown = () => {
            slugger.reset();
            if (markedRef) {
              contentEl.innerHTML = markedRef.parse(sourceMarkdown);
              if (window.hljs && typeof window.hljs.highlightAll === 'function') {
                window.hljs.highlightAll();
              }
            } else {
              contentEl.innerHTML = fallbackRender(sourceMarkdown);
            }
            // The source-directory base also affects fragments. Keep their actual
            // URLs in this preview, including when opened in another tab.
            contentEl.querySelectorAll('a[href^="#"]').forEach((anchor) => {
              const hash = anchor.getAttribute('href');
              anchor.dataset.openmdHash = hash;
              anchor.href = new URL(hash, window.location.href).href;
            });
          };

          const initGit = () => {
            if (!SOURCE.git) return;
            const panel = document.getElementById('git-panel');
            const select = document.getElementById('git-version');
            const detail = document.getElementById('git-detail');
            document.getElementById('git-status').textContent =
              `Branch: ${SOURCE.git.branch} · Repository: ${SOURCE.git.repositoryStatus} · File: ${SOURCE.git.fileStatus}`;
            SOURCE.git.versions.forEach((version, index) => {
              const option = document.createElement('option');
              option.value = String(index);
              option.textContent = version.label + (version.markdown === null ? ' (file unavailable)' : '');
              option.disabled = version.markdown === null;
              select.appendChild(option);
            });
            const update = () => {
              const version = SOURCE.git.versions[Number(select.value)];
              sourceMarkdown = version.markdown;
              detail.textContent = `${version.label} · ${version.detail}`;
              renderMarkdown();
              // A hash or the browser's scroll anchoring can otherwise jump to
              // an unrelated position in the newly rendered version.
              const previewURL = new URL(window.location.href);
              previewURL.hash = '';
              history.replaceState(null, '', previewURL.href);
              requestAnimationFrame(() => window.scrollTo({ top: 0, left: 0, behavior: 'instant' }));
            };
            select.value = '0';
            select.addEventListener('change', update);
            detail.textContent = `${SOURCE.git.versions[0].label} · ${SOURCE.git.versions[0].detail}`;
            panel.hidden = false;
          };

          const applyTheme = (mode) => {
            const resolved = mode === 'system' ? (mediaQuery.matches ? 'dark' : 'light') : mode;
            document.body.setAttribute('data-theme', resolved);
            document.body.setAttribute('data-theme-mode', mode);
          };

          const initTheme = () => {
            let initialTheme = 'system';
            try {
              const stored = localStorage.getItem(THEME_STORAGE_KEY);
              if (stored) {
                initialTheme = stored;
              }
            } catch (err) {
              console.warn('openmd: unable to access localStorage', err);
            }
            applyTheme(initialTheme);
            mediaQuery.addEventListener('change', () => {
              let mode = 'system';
              try {
                mode = localStorage.getItem(THEME_STORAGE_KEY) || 'system';
              } catch (err) {
                mode = 'system';
              }
              if (mode === 'system') {
                applyTheme('system');
              }
            });
            const themeButtons = document.querySelectorAll('button.theme-toggle');
            themeButtons.forEach((btn) => {
              btn.addEventListener('click', () => {
                const mode = btn.dataset.mode || 'system';
                applyTheme(mode);
                try {
                  localStorage.setItem(THEME_STORAGE_KEY, mode);
                } catch (err) {
                  console.warn('openmd: failed to persist theme preference', err);
                }
              });
            });
          };

          const showToast = (message) => {
            if (!toastEl) {
              return;
            }
            toastEl.textContent = message;
            toastEl.classList.add('show');
            if (toastTimer) {
              clearTimeout(toastTimer);
            }
            toastTimer = setTimeout(() => {
              toastEl.classList.remove('show');
              toastTimer = null;
            }, 2200);
          };

          const copyText = async (value, label) => {
            if (!value) {
              showToast('Nothing to copy');
              return;
            }
            if (navigator.clipboard && window.isSecureContext) {
              try {
                await navigator.clipboard.writeText(value);
                showToast(label);
                return;
              } catch (err) {
                console.warn('openmd: clipboard write failed', err);
              }
            }
            const textarea = document.createElement('textarea');
            textarea.value = value;
            textarea.setAttribute('readonly', '');
            textarea.style.position = 'fixed';
            textarea.style.top = '-9999px';
            textarea.style.opacity = '0';
            document.body.appendChild(textarea);
            textarea.focus();
            textarea.select();
            let copied = false;
            try {
              copied = document.execCommand('copy');
            } catch (err) {
              console.warn('openmd: fallback clipboard copy failed', err);
            }
            document.body.removeChild(textarea);
            showToast(copied ? label : 'Copy failed');
          };

          const initActions = () => {
            const actionButtons = document.querySelectorAll('[data-action]');
            actionButtons.forEach((btn) => {
              btn.addEventListener('click', () => {
                const action = btn.dataset.action;
                switch (action) {
                  case 'print':
                    window.print();
                    break;
                  case 'copy-markdown':
                    copyText(sourceMarkdown, 'Markdown copied');
                    break;
                  case 'copy-path':
                    copyText(SOURCE.file, 'Path copied');
                    break;
                  default:
                    break;
                }
              });
            });
          };

          const initAnchors = () => {
            if (window.location.hash) {
              requestAnimationFrame(() => {
                scrollToHash(window.location.hash, 'auto');
              });
            }
            window.addEventListener('hashchange', () => {
              scrollToHash(window.location.hash);
            });
            document.addEventListener('click', (event) => {
              if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
              const anchor = event.target.closest && event.target.closest('a[data-openmd-hash]');
              if (!anchor) {
                return;
              }
              const href = anchor.dataset.openmdHash;
              if (!href) {
                return;
              }
              event.preventDefault();
              const success = scrollToHash(href, 'smooth');
              if (success && window.location.hash !== href) {
                const previewURL = new URL(window.location.href);
                previewURL.hash = href;
                history.pushState(null, '', previewURL.href);
              }
            });
          };

          const init = () => {
            renderMarkdown();
            initGit();
            initTheme();
            initAnchors();
            initActions();
          };

          init();
        })();
